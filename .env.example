# API Settings
API_KEY=your-secret-api-key-here
HOST=0.0.0.0
PORT=8000

# Nyaa Configuration
NYAA_URL=https://nyaa.si
NYAA_NO_REMAKES=true
NYAA_TRUSTED_ONLY=false

# Newznab Configuration (Optional - upstream Usenet providers for /newznab)
# Simple single-provider setup, for example NZBGeek:
NEWZNAB_URL=https://api.nzbgeek.info
NEWZNAB_API_KEY=your_newznab_provider_api_key_here
NEWZNAB_ID=nzbgeek
NEWZNAB_NAME=NZBGeek
NEWZNAB_CATEGORIES=5070

# Advanced multi-provider setup. If set, this overrides the simple values above.
# NEWZNAB_PROVIDERS=[{"id":"nzbgeek","name":"NZBGeek","url":"https://api.nzbgeek.info","api_key":"your_newznab_provider_api_key_here","enabled":true,"categories":[5070],"priority":100,"timeout":30.0}]
NEWZNAB_MAX_QUERY_VARIANTS=8
NEWZNAB_DEFAULT_CATEGORIES=5070
PUBLIC_BASE_URL=

# Sonarr Configuration (Optional - for episode metadata lookup)
# When configured, the proxy can query Sonarr to accurately determine
# if an episode is a regular episode or a special/OVA
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Database Settings
DATA_DIR=/app/data
ANIME_DB_URL=https://raw.githubusercontent.com/manami-project/anime-offline-database/master/anime-offline-database-minified.json
ANIME_DB_UPDATE_INTERVAL=86400

# Cache Settings
CACHE_TTL=3600

# Search Settings
MAX_RESULTS_PER_QUERY=100
TORZNAB_DEFAULT_LANGUAGE=English

# Logging
LOG_LEVEL=INFO
